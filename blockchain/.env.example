# NEVER commit your real .env file to version control.
# Copy this file to .env and fill in your values.

# ─── Deployment Account ──────────────────────────────────────────────────────
# Your deployer wallet private key (without 0x prefix is also accepted)
# For LOCAL testing ONLY: use Hardhat's default test key below.
# NEVER use a mainnet/real-funds key here without understanding the risks.
# Default Hardhat test account #0 (DO NOT use on mainnet):
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# ─── Sepolia RPC URL ──────────────────────────────────────────────────────────
# Get a free RPC URL from Alchemy (https://alchemy.com) or Infura (https://infura.io)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# ─── Etherscan API Key ───────────────────────────────────────────────────────
# Get from https://etherscan.io/myapikey
# Used for contract verification on Sepolia
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

